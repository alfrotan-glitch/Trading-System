venv/
dist/
build/
*.egg

# Data — large, reproducible via ingest
data/curated/
data/raw/*.csv
data/raw/*.parquet
data/sqlite/*.db
data/sqlite/*.db-wal
data/sqlite/*.db-shm
logs/
*.parquet
