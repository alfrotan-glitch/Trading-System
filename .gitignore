# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.egg

# Data — large, reproducible via ingest
data/curated/
data/raw/*.csv
data/raw/*.parquet
data/sqlite/*.db
data/sqlite/*.db-wal
data/sqlite/*.db-shm
logs/
*.parquet
!data/fixtures/*.parquet
!data/fixtures/*.csv

# Secrets / env
.env
.env.*
*.key
configs/live.yaml
configs/*live*.yaml
audit.jsonl
logs/audit.jsonl

# Tool
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# OS
.DS_Store

# Machine-local Setup Wizard persistence (credential-free MT5 connection metadata)
data/setup/

# Generated dataset registries — recreated deterministically by `qts data bootstrap`
# (committing manifests without the gitignored curated/DB data creates phantom
# "versions" that resolve to zero usable bars on a clean clone)
data/manifests/

# Desktop-produced session-evidence exports — machine-local artifacts, transferred
# deliberately for audit; never committed accidentally.
data/evidence/exports/

# Node (UI dev-test harness only — the product has no Node dependency)
node_modules/

# UX visual-review artifacts (screenshots regenerated by tests/scripts)
artifacts/
