# QTS environment template. Copy to .env (never commit the copy).
# Every value here is conservative by default: research/demo only, LIVE locked.

# --- Mode -------------------------------------------------------------------
# development | paper | shadow | demo_forward | live
# "live" does not unlock live trading; the structural lock is in code.
QTS_ENV=development
# MOCK | REAL — REAL probes an MT5 terminal and still refuses a non-DEMO account.
QTS_MT5_MODE=MOCK

# --- Server -----------------------------------------------------------------
QTS_API_HOST=127.0.0.1
QTS_API_PORT=8000
# Required to bind a non-loopback address. Only behind an authenticated TLS proxy.
# QTS_ALLOW_REMOTE=1
# Comma-separated exact origins/hosts allowed to mutate state (e.g. a TLS proxy).
# Loopback is always trusted; remote preview hosts are never trusted implicitly.
# QTS_ALLOWED_ORIGINS=https://qts.example.com
# CSP frame-ancestors value. Default 'none' (clickjacking denied).
# QTS_FRAME_ANCESTORS=https://ops.example.com
QTS_MAX_BODY_BYTES=1048576
QTS_LOG_LEVEL=info

# --- State ------------------------------------------------------------------
# Absolute root for journals, SQLite risk/authority DBs and the identity pin.
# QTS_STATE_ROOT=/var/lib/qts
# Curated dataset store (parquet + manifests). Defaults to <QTS_STATE_ROOT>/data.
# QTS_DATA_ROOT=/var/lib/qts/data
# Per-artefact overrides (only for portable installs and tests):
# QTS_DB_PATH=/var/lib/qts/data/sqlite/qts.db
# QTS_SETUP_FILE=/var/lib/qts/data/setup/mt5_setup.json

# --- Observability ----------------------------------------------------------
QTS_AUDIT_JSONL_PATH=logs/audit.jsonl
